# ThesKwoff Hotel production environment
# Copy to .env.production on the VPS, fill in real values, then run npm run build.

NODE_ENV=production
PORT=3000
SITE_URL=https://theskwoffhotel.com

# Supabase project settings from the new Supabase account.
SUPABASE_PROJECT_ID=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required before storing payroll bank or mobile-money details.
# Supply a base64-encoded, randomly generated 32-byte key; never expose it through VITE_*.
PAYROLL_FIELD_ENCRYPTION_KEY=

# Vite embeds these values into the browser bundle at build time.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Protect scheduled public hook endpoints.
CRON_SECRET=

# Optional integrations. Leave blank until configured.
PRINTNODE_API_KEY=
VIRUSTOTAL_API_KEY=
BOOKING_COM_WEBHOOK_SECRET=
RESEND_API_KEY=
ANALYTICS_EMAIL_FROM=
LOVABLE_API_KEY=

# Server-only. Powers AI product image generation. Never expose via VITE_*.
OPENAI_API_KEY=

# Test harness must remain disabled in production.
TEST_HARNESS_ENABLED=0
TEST_HARNESS_SECRET=

# Deployment identity. All optional: with none of them set the application
# renders exactly the strings it always has. They exist so a SECOND deployment
# of this same codebase (see .env.demo.example) can name itself without a fork.
#   APP_ENV / VITE_APP_ENV            which deployment this is; unset = production
#   APP_ENV_LABEL / VITE_APP_ENV_LABEL  staff-facing environment strip; unset = no strip
#   APP_BRAND_NAME / VITE_APP_BRAND_NAME  name for build-time surfaces (tab titles,
#                                     og: meta, print/PDF headers, passkey prompt)
#   ACCOUNTS_EMAIL_DOMAIN             domain for identifier-only staff placeholders
# Leave every one of them unset in production.
