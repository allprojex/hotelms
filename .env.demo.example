# Infinity PMS — DEMO deployment environment
#
# Copy to /opt/infinity-pms-demo/.env.demo on the VPS, fill in the real values,
# chmod 600, then build. This file documents a SECOND deployment of the same
# application: identical code, identical modules, identical migrations — only
# the environment, the database and the data differ.
#
# NOTHING HERE MAY EVER CONTAIN A PRODUCTION VALUE. The demo has its own
# Supabase project, its own keys and its own domain; copying a production
# secret into this file defeats the entire isolation design.

NODE_ENV=production
PORT=3200
SITE_URL=https://app.infinitytechub.com

# ── Deployment identity ──────────────────────────────────────────────────────
# APP_ENV is deliberately separate from NODE_ENV: this IS a production build
# and must keep behaving like one (the RBAC test harness, for instance, refuses
# to activate unless NODE_ENV is not "production" — that protection must hold
# here too). APP_ENV only answers "which deployment is this?".
APP_ENV=demo
VITE_APP_ENV=demo

# Optional. Defaults to "DEMO" whenever APP_ENV=demo. This is the text in the
# staff-facing environment strip; leave it unset unless you want different
# wording.
# APP_ENV_LABEL=DEMO
# VITE_APP_ENV_LABEL=DEMO

# Name used by build-time and out-of-band surfaces that cannot reach the
# database: browser tab titles, og:/twitter: meta, print footers, PDF metadata,
# the browser's passkey prompt, HRM report headers. In-app branding still comes
# from the Branding console (system_settings + property_branding) and wins
# everywhere it is available — this is only the name for the places a query
# cannot reach.
APP_BRAND_NAME=Infinity Grand Hotel
VITE_APP_BRAND_NAME=Infinity Grand Hotel

# Domain for the non-routable placeholder address minted for an
# identifier-only staff account. `.invalid` is reserved by RFC 2606 and can
# never receive mail; this only stops demo accounts carrying another
# operator's domain name.
ACCOUNTS_EMAIL_DOMAIN=accounts.infinitygrand.invalid

# Crawler-facing values are also read from SITE_URL, but the browser bundle
# needs its own copy inlined at build time.
VITE_SITE_URL=https://app.infinitytechub.com

# ── Demo Supabase project ────────────────────────────────────────────────────
# A SEPARATE project. Verify the ref is NOT the production ref recorded in
# scripts/prod/production.config.json before saving this file.
#
# WARNING: Vite embeds EVERY variable whose name begins with VITE_ into the
# browser bundle at build time, whether or not any code reads it. The only
# values in this file that may carry a VITE_ prefix are the deployment-identity
# ones above and the three VITE_SUPABASE_* below — the same three production
# already publishes. NEVER prefix a service-role key, the payroll encryption
# key, the cron secret or any third-party API key with VITE_.
SUPABASE_PROJECT_ID=
SUPABASE_URL=https://your-demo-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://your-demo-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required before storing payroll bank / mobile-money details, which the demo
# does need — payroll payment details are part of the demonstration. Generate a
# fresh 32-byte key for the demo; never reuse production's.
#   openssl rand -base64 32
PAYROLL_FIELD_ENCRYPTION_KEY=

# Protects the scheduled hook endpoints. Generate a unique value even though
# the demo deliberately schedules no pg_cron jobs — an unset value makes those
# endpoints answer 500 rather than 401.
CRON_SECRET=

# ── Integrations: deliberately unset ─────────────────────────────────────────
# Every one of these degrades safely when blank. Leaving them empty is what
# guarantees the demo cannot email a real person, print on real hardware, or
# call a third party. Do not populate them with production values.
PRINTNODE_API_KEY=
VIRUSTOTAL_API_KEY=
BOOKING_COM_WEBHOOK_SECRET=
RESEND_API_KEY=
ANALYTICS_EMAIL_FROM=
LOVABLE_API_KEY=

# Server-only. Powers AI product image generation. Optional for the demo — if
# you want to show it, use a SEPARATE, spend-capped key, never production's.
OPENAI_API_KEY=

# Must remain disabled, exactly as in production.
TEST_HARNESS_ENABLED=0
TEST_HARNESS_SECRET=
