# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Python test/cache artifacts
__pycache__/
*.py[cod]

# Environment files. Never commit real Supabase/API credentials.
.env
.env.*
!.env.example
!.env.production.example
!.env.test.example

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Local Supabase CLI link/cache data (may contain connection details).
supabase/.temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

supabase/.branches/

# Production release run artifacts. Release PLANS
# (scripts/prod/releases/*.json — the human-authored approval record, no
# secrets) are meant to be committed; the timestamped run directories each
# release generates (raw stage logs + report.md) are not auto-committed —
# a human chooses which report.md to keep as a permanent audit record via
# `git add -f`.
scripts/prod/releases/*/
